<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Roon discovery is a UDP multicast, and Android filters multicast out of
      userspace unless the app holds a WifiManager multicast lock. Without
      this permission the lock cannot be taken, the SOOD replies never arrive,
      and a network with a Roon Core on it reports none. See WifiMulticastLock
      in MigrateService.kt.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      A migration of a real library takes minutes — thousands of searches
      against two rate-limited services, with every 429 waited out. The person
      will lock their phone during it, and a plain activity's process is
      killable the moment it leaves the screen. See MigrateService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Only so the ongoing notification can be shown while a migration runs. The
      app posts nothing else, ever, and if this is refused the migration still
      works — it is simply killable when the screen goes off.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      From Android 11 an app cannot see another package unless it says what it
      is looking for. The sign-ins deliberately open in a REAL BROWSER rather
      than in this app's WebView (see MainActivity), and without this the
      browser is invisible and the ACTION_VIEW silently goes nowhere.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          networkSecurityConfig is LOAD-BEARING, not hardening.

          Without it the WebView cannot load this app's own page — Android
          denies cleartext HTTP by default at targetSdk 28+, and the whole UI is
          served over plain HTTP from 127.0.0.1 by MigrateService. v0.1.0
          shipped without it and every launch showed
          net::ERR_CLEARTEXT_NOT_PERMITTED. See the file for why the exemption
          is scoped to loopback instead of turned on globally.
        -->

        <!--
          allowBackup is OFF, deliberately.

          The database holds two services' access tokens. Android's automatic
          backup would copy them to the user's cloud storage and restore them
          onto a different device, which is not something anyone asked for when
          they signed in on this phone. The match cache is the only other thing
          in there and it is a cache.
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not exported: nothing outside this app has any business starting it,
          and it is started by MainActivity alone.
        -->
        <service
            android:name=".MigrateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
